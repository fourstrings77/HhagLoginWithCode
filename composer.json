{
    "name": "hhag-login-with-code/hhag-login-with-code",
    "description": "hhag-login-with-code/hhag-login-with-code",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.6.0"
    },
    "extra": {
        "shopware-plugin-class": "HhagLoginWithCode\\HhagLoginWithCode",
        "label": {
            "de-DE": "Login per Code",
            "en-GB": "Login with Code"
        }
    },
    "autoload": {
        "psr-4": {
            "HhagLoginWithCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HhagLoginWithCode\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.71",
        "shopwarelabs/phpstan-shopware": "^0.1.9",
        "phpstan/phpstan-phpunit": "^2.0"

    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
